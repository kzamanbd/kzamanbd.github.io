{
    "name": "kzamanbd-portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "browserslist": [
        "chrome >= 111",
        "edge >= 111",
        "firefox >= 128",
        "safari >= 16.4",
        "not dead"
    ],
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:https": "next dev --experimental-https",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint src --max-warnings 0",
        "check-types": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "prettier": {
        "$schema": "https://json.schemastore.org/prettierrc",
        "semi": true,
        "tabWidth": 4,
        "singleQuote": true,
        "printWidth": 100,
        "trailingComma": "none",
        "bracketSameLine": true,
        "endOfLine": "crlf",
        "plugins": [
            "prettier-plugin-tailwindcss"
        ]
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.0",
        "@next/third-parties": "16.2.4",
        "@serwist/next": "^9.5.12",
        "@serwist/window": "^9.5.12",
        "@xyflow/react": "^12.11.2",
        "clsx": "^2.1.1",
        "firebase": "^12.17.1",
        "gemoji": "^8.1.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^0.539.0",
        "marked": "^18.0.9",
        "marked-alert": "^2.1.2",
        "marked-emoji": "^2.0.3",
        "marked-footnote": "^1.4.0",
        "mermaid": "^11.16.1",
        "next": "16.3.0",
        "next-themes": "^0.4.6",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "resend": "^6.18.1",
        "shiki": "^4.4.2",
        "simple-icons": "^16.28.0",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^15.5.22",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^20.19.43",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.5.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "schema-dts": "^1.1.5",
        "serwist": "^9.5.12",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    }
}
