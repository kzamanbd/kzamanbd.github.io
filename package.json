{
    "name": "kzamanbd-portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "browserslist": [
        "chrome >= 111",
        "edge >= 111",
        "firefox >= 128",
        "safari >= 16.4",
        "not dead"
    ],
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:https": "next dev --experimental-https",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint src --max-warnings 0",
        "check-types": "tsc --noEmit",
        "format": "prettier --write src",
        "format:check": "prettier --check src"
    },
    "prettier": {
        "$schema": "https://json.schemastore.org/prettierrc",
        "semi": true,
        "tabWidth": 4,
        "singleQuote": true,
        "printWidth": 100,
        "trailingComma": "none",
        "bracketSameLine": true,
        "endOfLine": "crlf",
        "plugins": [
            "prettier-plugin-tailwindcss"
        ]
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@next/third-parties": "16.4.1",
        "@serwist/next": "^9.5.13",
        "@serwist/window": "^9.5.13",
        "@xyflow/react": "^12.12.0",
        "clsx": "^2.1.1",
        "firebase": "^13.0.0",
        "gemoji": "^8.1.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^1.57.0",
        "marked": "^18.1.1",
        "marked-alert": "^2.1.2",
        "marked-emoji": "^3.0.0",
        "marked-footnote": "^1.4.0",
        "mermaid": "^12.2.0",
        "next": "16.4.1",
        "next-themes": "^0.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "resend": "^6.33.0",
        "shiki": "^4.5.0",
        "simple-icons": "^16.35.0",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@next/eslint-plugin-next": "^16.4.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "schema-dts": "^2.1.0",
        "serwist": "^9.5.13",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
